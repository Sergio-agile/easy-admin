<%= content_for :breadcrumbs do %>
  <%= breadcrumb_list do %>
    <%= breadcrumb_item 'Consultations' %>
  <% end %>
<% end %>

<%= content_for :contents do %>
  <div class="container pt-5">
    <div class="row" >
      <div class="col">
        <h1 class="page-header ">Consultations</h1>
      </div>
      <div class="col text-end">
      <%= link_to 'New consultation', '', class: 'btn btn-success px-4 rounded-pill' %>
      </div>
    </div>
    <%= render "search_form", url: consultations_path, frame: "consultations" %>
    <%= turbo_frame_tag "consultations", target: "_top" do %>
      <%= render "table" %>
      <%= paginate @consultations %>
    <% end %>
  </div>
<% end %>
