<%# all templates should be:

- content_for :title do
  = fe_title :detentions

- content_for :breadcrumbs do (DONE)


- content_for :actions do (THIS SHOULD INCLUDE FILTERS AND ACTIONS AFTER REFACTORING THEM)
  = fe_filter :detention_list_cover, as: :select, collection: detentions_collection
  = fe_filter :detention_type_ids, as: :select, collection: detention_template_collection, include_blank: true, multiple: true

  = fe_action :create, new_detentions_detention_path, [:my_detentions, :can_create], classes: 'ms-auto', title: t('actions.set_detention')

  - content_for :contents do
    end %>


<%= content_for :breadcrumbs do %>
  <%= breadcrumb_list do %>
    <%= breadcrumb_item 'Patients' %>
  <% end %>
<% end %>

<%= content_for :contents do %>
  <div class="container pt-5">
    <div class="row" >
      <div class="col">
        <h1 class="page-header ">Patients</h1>
      </div>
      <div class="col text-end">
        <%= link_to 'New Patient', new_patient_path, class: "btn btn-success px-4 rounded-pill" %>
      </div>
    </div>
    <%= render "search_form", url: patients_path, frame: "patients" %>
    <%= turbo_frame_tag "patients", target: "_top" do %>
      <%= render "table" %>
      <%= paginate @patients %>
    <% end %>
  </div>
<% end %>


