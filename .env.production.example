# Copy to .env.production on the server and fill in the values
RAILS_MASTER_KEY=          # contents of config/master.key
EASY_ADMIN_DATABASE_PASSWORD=

# Behind an HTTPS reverse proxy (nginx/Caddy) keep both true.
# Without HTTPS (e.g. testing by IP) set both to false.
RAILS_FORCE_SSL=true
RAILS_ASSUME_SSL=true

# Port exposed on the host; 127.0.0.1 so only the reverse proxy can reach it
APP_BIND=127.0.0.1
APP_PORT=3000
